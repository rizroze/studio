{
  "redirects": [
    {
      "source": "/direction",
      "destination": "/works/direction",
      "permanent": true
    },
    {
      "source": "/design",
      "destination": "/works/design",
      "permanent": true
    },
    {
      "source": "/product",
      "destination": "/works/product",
      "permanent": true
    },
    {
      "source": "/experiments",
      "destination": "/works/experiments",
      "permanent": true
    },
    {
      "source": "/motion",
      "destination": "/works/motion",
      "permanent": true
    },
    {
      "source": "/work",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/work/:slug*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/v2/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/discovery",
      "destination": "/discovery/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/share-card-red-1000.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800"
        }
      ]
    }
  ]
}
